{
  "hosting": [
    {
      "site": "ethoz",
      "public": "build",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "logos/preview.html"
      ],
      "redirects": [
        {
          "source": "/resources/breach-response-plan{,/**}",
          "destination": "/recursos/plan-respuesta-brechas",
          "type": 301
        },
        {
          "source": "/resources/compliance-checklist{,/**}",
          "destination": "/recursos/checklist-cumplimiento",
          "type": 301
        },
        {
          "source": "/resources/data-inventory{,/**}",
          "destination": "/recursos/inventario-datos",
          "type": 301
        },
        {
          "source": "/resources/pickup-protocol{,/**}",
          "destination": "/recursos/protocolo-retiros",
          "type": 301
        },
        {
          "source": "/resources/privacy-notice{,/**}",
          "destination": "/recursos/aviso-privacidad",
          "type": 301
        },
        {
          "source": "/resources/roles-permissions-guide{,/**}",
          "destination": "/recursos/guia-roles-permisos",
          "type": 301
        },
        {
          "source": "/resources{,/**}",
          "destination": "/recursos",
          "type": 301
        },
        {
          "source": "/features/student-profile{,/**}",
          "destination": "/funcionalidades/ficha-alumno",
          "type": 301
        },
        {
          "source": "/features/safe-pickups{,/**}",
          "destination": "/funcionalidades/retiros-seguros",
          "type": 301
        },
        {
          "source": "/features/access-control{,/**}",
          "destination": "/funcionalidades/acceso-por-rol",
          "type": 301
        },
        {
          "source": "/features/smart-search{,/**}",
          "destination": "/funcionalidades/busqueda-contextual",
          "type": 301
        },
        {
          "source": "/features/privacy-compliance{,/**}",
          "destination": "/funcionalidades/privacidad-datos",
          "type": 301
        },
        {
          "source": "/features/alerts{,/**}",
          "destination": "/funcionalidades/alertas",
          "type": 301
        },
        {
          "source": "/features/analytics{,/**}",
          "destination": "/funcionalidades/indicadores",
          "type": 301
        },
        {
          "source": "/features/emergency{,/**}",
          "destination": "/funcionalidades/emergencias",
          "type": 301
        },
        {
          "source": "/features/attendance{,/**}",
          "destination": "/funcionalidades/asistencia",
          "type": 301
        },
        {
          "source": "/about{,/**}",
          "destination": "/nosotros",
          "type": 301
        },
        {
          "source": "/contact{,/**}",
          "destination": "/contacto",
          "type": 301
        },
        {
          "source": "/integrations{,/**}",
          "destination": "/integraciones",
          "type": 301
        },
        {
          "source": "/get-started{,/**}",
          "destination": "/como-contratar",
          "type": 301
        },
        {
          "source": "/compliance{,/**}",
          "destination": "/cumplimiento",
          "type": 301
        },
        {
          "source": "/roi-calculator{,/**}",
          "destination": "/calculadora-roi",
          "type": 301
        },
        {
          "source": "/privacy{,/**}",
          "destination": "/privacidad",
          "type": 301
        },
        {
          "source": "/terms{,/**}",
          "destination": "/terminos",
          "type": 301
        },
        {
          "source": "/schedule{,/**}",
          "destination": "/agendar",
          "type": 301
        },
        {
          "source": "/pitch{,/**}",
          "destination": "/presentacion",
          "type": 301
        },
        {
          "source": "/suggestions{,/**}",
          "destination": "/sugerencias",
          "type": 301
        },
        {
          "source": "/en{,/**}",
          "destination": "/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/sugerencias",
          "destination": "/200.html"
        },
        {
          "source": "/demo/**",
          "destination": "/200.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://app.cal.com https://*.cal.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://www.gstatic.com https://www.clarity.ms https://*.clarity.ms https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.basemaps.cartocdn.com; connect-src 'self' https://app.ethoz.cl https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://www.clarity.ms https://*.clarity.ms https://www.google-analytics.com https://api.cal.com https://app.cal.com https://*.cal.com https://*.basemaps.cartocdn.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://app.cal.com; font-src 'self' data:; frame-src https://app.cal.com https://*.cal.com https://www.google.com; worker-src 'self' blob:; report-uri https://o4511169804500992.ingest.us.sentry.io/api/4511169807843328/security/?sentry_key=47b75aa781e8cd28829b3031cc1ed042"
            }
          ]
        },
        {
          "source": "/agendar",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/presentacion",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/sugerencias",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/demo/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/logos/preview{,.html}",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|webp|avif|png|jpg|svg|woff|woff2|json|m4a|mp4|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/data/**/*.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false
    },
